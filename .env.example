# ═══════════════════════════════════════════════════════════
# FinanceHub — Configuration Template
# Copy this file to `.env` and fill in real values:
#   cp .env.example .env
# ═══════════════════════════════════════════════════════════

# ─── Database ───────────────────────────────────────────
# NOTE: on a fresh install these values are used to create the MySQL
# user/database on first `docker compose up`. If you change DB_PASS
# later you must also ALTER the password inside MySQL.
DB_HOST=db
DB_PORT=3306
DB_NAME=financehub
DB_USER=financehub_user
DB_PASS=12345AB

# ─── JWT ────────────────────────────────────────────────
# Generate with: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
JWT_SECRET=CHANGE_ME_random_64_hex_chars
JWT_EXPIRY=3600
JWT_REFRESH_EXPIRY=604800

# ─── Anthropic / AI (optional — app works with fallbacks if empty) ──
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
AI_RATE_LIMIT_MINUTE=10
AI_RATE_LIMIT_DAILY=100
AUTH_RATE_LIMIT_MINUTE=20

# ─── Backend ────────────────────────────────────────────
BACKEND_PORT=8000
# Exact origin(s) allowed by CORS — comma separated, no trailing slash
BACKEND_CORS_ORIGIN=http://localhost,http://localhost:3000
APP_DEBUG=false
TZ=Africa/Algiers

# ─── Frontend (baked at build time) ─────────────────────
NEXT_PUBLIC_API_URL=http://localhost/api/v1
NEXT_PUBLIC_APP_URL=http://localhost
NEXT_PUBLIC_FINANCE_CURRENCY=DZD

# Web Push (VAPID)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@financehub.dz
